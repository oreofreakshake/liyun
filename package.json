{
  "name": "liyun",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "next dev",
    "build": "node packages/spellcheck/tools/fetch-lexicon.mjs && next build",
    "start": "next start",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "app:icon": "d=$(mktemp -d) && xcrun actool --compile $d --platform macosx --minimum-deployment-target 11.0 --app-icon Liyun --output-partial-info-plist $d/info.plist src-tauri/icons/Liyun.icon >/dev/null && cp $d/Assets.car src-tauri/icons/",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "bun test packages",
    "templates": "bun packages/editor/scripts/templates.ts",
    "spellcheck": "bun packages/spellcheck/tools/build-lexicon.ts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "editor": "workspace:*",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "store": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@tailwindcss/postcss": "4.3.3",
    "@tauri-apps/cli": "2.12.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "1.64.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "workspaces": [
    "packages/*"
  ]
}
